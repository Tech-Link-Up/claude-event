# Claude Builder Day — environment variables
#
# Copy this file into the root of your Next.js app as `.env.local`,
# then replace the placeholder values with your own (Step 5 of the guide).
# `.env.local` is gitignored, so your real keys never get committed.
#
# Note: these names deliberately do NOT start with NEXT_PUBLIC_ —
# that keeps them server-only. Never add that prefix to a secret.

# Your Supabase project URL
# Find it: Supabase dashboard → Project Settings → API Keys
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase secret key — full database access, server-only.
# Find it: same page, under "Secret keys" → click Reveal
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
